#!/usr/bin/env python3
"""fit — CLI do assistente para o banco do app (Supabase), por HTTPS, executando como role `bot`.

Cada comando roda `begin; set local role bot; <um comando SQL>; commit;` pela Management API:
RLS e grants mínimos do bot valem (sem DDL, sem auth). Toda escrita leva source='bot'.
Datas: AAAA-MM-DD, 'hoje', 'ontem', 'amanha' ou dd/mm. Horas: HH:MM.

LEITURA
  fit today                                   plano de hoje (v_today) com status
  fit week [--next]                           meta semanal (N/4 · faixa 4–9) + semana atual (ou a próxima) com exceções e status
  fit evo                                     recomposição + peso + PRs recentes + meta semanal ("como estou indo?")
  fit summary [week|month] [--n 2]            resumos: treinos vs meta semanal, PRs, saldo real vs meta (−300/dia), proteína,
                                              carbo e gordura por zona (só dias na conta), peso, cintura
  fit day [data]                              meta semanal + refeições do dia + totais: meta fixa, pode consumir, resta e
                                              proteína / carbo / gordura por zona (docs/proteina.md, docs/macros.md)
  fit food <busca> [--limit 8]                busca custom > TBCA > TACO (sem acento, por similaridade; coluna fonte)
  fit notes [--limit 10]                      últimas notas do assistente
  fit sessions [--limit 10]                   últimas sessões (v_sessions)
  fit videos                                  confere os links de vídeo pelo oEmbed (checagem mensal)
  fit sql "<SELECT ...>"                      SQL livre como bot (um comando)

TREINO
  fit session feito|faltou|parcial [--date d] [--time HH:MM | --title texto] [--note t]
        marca a atividade do plano daquele dia (sem --time/--title: a única/primeira pendente)
  fit log-set <exercicio_slug> <kg> <reps> [--set n] [--date d] [--rir r] [--warmup] [--session id]
        registra série (cria/usa a sessão do dia da ficha que contém o exercício)
  fit carga <exercicio_slug> <kg> [--template slug] [--motivo t]    carga-alvo (gera bot_note 'carga')
  fit target <ficha_slug|id> <exercicio (nome ou slug)> [--kg X] [--reps N] [--motivo t]
        alvo da próxima sessão (carga_alvo / reps_alvo; o app pré-preenche com "sugerido"); sem --kg/--reps mostra

AGENDA (exceções; a grade base só muda com confirmação explícita do Kaluan)
  fit move <data> <HH:MM> --to <data> <HH:MM> [--motivo t]   remarca (pula a original + adiciona a nova)
  fit skip <data> <HH:MM> [--motivo t]                        pula uma ocorrência
  fit add <data> <HH:MM> <modalidade> [--template slug] [--title t] [--dur min] [--motivo t]
        modalidade: musculacao | muay_thai | jiu_jitsu | cross | funcional

CORPO
  fit body [peso] [--cintura x] [--abdomen x] [--quadril x] [--peito x] [--braco x] [--coxa x]
           [--gordura x] [--date d] [--nota t]        upsert na data (campos omitidos ficam como estão)
  fit body <peso> <cintura>                            atalho legado
  fit photo <arquivo> --pose frente|lado|costas [--date d] [--nota t]
        remove EXIF, redimensiona (1600 px) e gera miniatura (400 px), sobe no bucket privado `progress`

NUTRIÇÃO
  fit meal <refeicao> <item> [<item> ...] [--date d] [--estimated] [--note t]
        item = "<codigo|nome>=<qtd>"  qtd: 150g | 2 "colher de sopa" (ex.: "tbca:BRC0001C=150g", "taco:3=150g")
        item livre: "desc=Whey 1 scoop;g=30;kcal=120;p=24;c=3;f=1.5"
  fit meal-del <id>                                     apaga um item de refeição
  fit meal-photo <arquivo> <refeicao> [--date d] [--note t]
        foto da refeição (mesmo nome de food_logs.meal): sem EXIF, 1600 px + miniatura 400 px, bucket privado `meals`
  fit food-add <slug> "<nome>" <kcal> <prot> <carb> <gord> [--fiber x] [--portion "1 un=350"]
        alimento custom por 100 g (código custom:<slug>)
  fit portion <codigo> "<medida>" <gramas>              medida caseira (ex.: "1 colher de sopa" = 25 g)
  fit tbca "<termo ou código>" [--all] [--limit 10]     busca no site da TBCA, baixa o detalhe e cadastra em foods (fonte TBCA)
        um resultado (ou código exato): cadastra. Vários: lista; escolha com fit tbca <código> ou cadastre os listados com --all
  fit diario incompleto|completo [data] [--nota t]      marca o diário do dia (incompleto = fora do saldo acumulado
        e das médias; ex.: refeição que ficou sem registro, dia placeholder). Só com o que o Kaluan disser.
  fit water <ml> [--date d]                             água do dia
  fit steps <n> [--date d]                              passos do dia (só exibição; não mudam o gasto)

CALORIAS (gasto × consumo; regra em docs/calorias.md)
  Meta do dia = saldo-alvo FIXO (−300), treine ou não. Pode consumir = basal + rotina + exercício feito + saldo-alvo.
  fit saldo-alvo [kcal]                                 mostra ou muda o saldo-alvo (ex.: -300). Só com pedido do Kaluan
  fit kcal <kcal> [--session <id>|--date d] [--note t]  kcal ATIVAS do relógio (source relogio); por sessão = upsert
  fit kcal-del <id>                                     apaga uma leitura do relógio
  fit kcal-day [data]                                   basal + rotina + exercício × comida = saldo do dia, meta,
                                                        pode consumir e resta
  fit perfil [--altura cm] [--nascimento AAAA-MM-DD] [--sexo M|F] [--fator 1.2]
        dados do basal (Mifflin-St Jeor); sem opções mostra o perfil. Só com valores informados pelo Kaluan.

NOTAS
  fit note <nota|decisao|carga|remarcacao|alerta|resumo> "<texto>"

MANUTENÇÃO
  fit admin-sql "<SQL>"                                 como postgres (evitar; só manutenção)

Token: $SUPABASE_ACCESS_TOKEN ou /home/box/.secrets/supabase_access_token (nunca impresso).
FIT_ROLLBACK=1 executa cada comando e desfaz (teste sem gravar). FIT_PSQL=<dsn> roda o mesmo SQL num Postgres local (testes).
"""
import datetime as dt, json, os, re, sys, urllib.error, urllib.parse, urllib.request
from zoneinfo import ZoneInfo

REF = os.environ.get("SUPABASE_PROJECT_REF", "qlphmxjehsexuxspspaw")
TOKEN_FILE = "/home/box/.secrets/supabase_access_token"
KEYS_FILE = "/home/box/.secrets/fitness_supabase_keys.env"
TZ = ZoneInfo("America/Sao_Paulo")
MODALITIES = ("musculacao", "muay_thai", "jiu_jitsu", "cross", "funcional")
NOTE_KINDS = ("nota", "decisao", "carga", "remarcacao", "alerta", "resumo")


# ---------------------------------------------------------------- transporte
def token():
    t = os.environ.get("SUPABASE_ACCESS_TOKEN")
    if not t and os.path.exists(TOKEN_FILE):
        t = open(TOKEN_FILE).read().strip()
    if not t:
        sys.exit("erro: SUPABASE_ACCESS_TOKEN ausente")
    return t


def run_psql(dsn, query):
    """FIT_PSQL=<dsn>: mesmo SQL num Postgres local (testes com scripts/verify_local.sh). Valores voltam como texto."""
    import csv, io, subprocess
    p = subprocess.run(["psql", dsn, "-X", "-q", "--csv", "-v", "ON_ERROR_STOP=1", "-f", "-"],
                       input=query, capture_output=True, text=True)
    if p.returncode:
        sys.exit("erro psql: " + p.stderr.strip().splitlines()[-1] if p.stderr.strip() else "erro psql")
    out = p.stdout.strip()
    return list(csv.DictReader(io.StringIO(out))) if out else []


def run(query):
    if os.environ.get("FIT_PSQL"):
        return run_psql(os.environ["FIT_PSQL"], query)
    req = urllib.request.Request(f"https://api.supabase.com/v1/projects/{REF}/database/query",
        data=json.dumps({"query": query}).encode(), method="POST",
        headers={"Authorization": "Bearer " + token(), "Content-Type": "application/json", "User-Agent": "fit-cli"})
    try:
        return json.load(urllib.request.urlopen(req, timeout=120))
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message", "")
        except Exception:
            msg = str(e)
        sys.exit(f"erro {e.code}: {msg}")


# Bloqueia tentativas de sair do role bot dentro da mesma requisição.
ESCAPE = re.compile(r"\b(role|session_authorization|commit|rollback|begin|abort|savepoint|release|prepare|reset|set_config)\b", re.I)


def bot(query):
    bare = re.sub(r"'(?:[^']|'')*'", "''", query)
    if ESCAPE.search(bare):
        sys.exit("erro: SQL do bot não pode conter controle de transação/role (begin/commit/set/reset/role...)")
    q = query.strip().rstrip(";").strip()
    bare = re.sub(r"'(?:[^']|'')*'", "''", q)
    if ";" in bare or "$" in bare or "--" in bare or "/*" in bare:
        sys.exit("erro: o bot executa um único comando por chamada (sem ';', '$', comentários)")
    end = "rollback;" if os.environ.get("FIT_ROLLBACK") else "commit;"   # FIT_ROLLBACK=1: testa sem gravar
    return run(f"begin; set local role bot; set local statement_timeout = '30s';\n{q};\n{end}")


def lit(v):
    return "null" if v is None else "'" + str(v).replace("'", "''") + "'"


def show(rows):
    print(json.dumps(rows, ensure_ascii=False, indent=1, default=str))


def table(rows, cols=None):
    if not rows:
        print("(nada)")
        return
    cols = cols or list(rows[0].keys())
    w = {c: max(len(c), *(len(fmt(r.get(c))) for r in rows)) for c in cols}
    print("  ".join(c.ljust(w[c]) for c in cols))
    for r in rows:
        print("  ".join(fmt(r.get(c)).ljust(w[c]) for c in cols))


def fmt(v):
    if v is None:
        return "–"
    if isinstance(v, float):
        return f"{v:g}"
    return str(v)


# ---------------------------------------------------------------- argumentos
def opts(args, flags=(), bools=()):
    """Separa posicionais de --flag valor / --bool."""
    pos, o = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--") and a[2:] in bools:
            o[a[2:]] = True
        elif a.startswith("--") and a[2:] in flags:
            if i + 1 >= len(args):
                sys.exit(f"erro: {a} precisa de valor")
            o[a[2:]] = args[i + 1]
            i += 1
        elif a.startswith("--"):
            sys.exit(f"erro: opção desconhecida {a}")
        else:
            pos.append(a)
        i += 1
    return pos, o


def today():
    return dt.datetime.now(TZ).date()


def pdate(s):
    if s is None or s in ("hoje", "today"):
        return today().isoformat()
    if s in ("ontem", "yesterday"):
        return (today() - dt.timedelta(days=1)).isoformat()
    if s in ("amanha", "amanhã", "tomorrow"):
        return (today() + dt.timedelta(days=1)).isoformat()
    m = re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/(\d{4}))?", s)
    if m:
        y = int(m.group(3) or today().year)
        return dt.date(y, int(m.group(2)), int(m.group(1))).isoformat()
    try:
        return dt.date.fromisoformat(s).isoformat()
    except ValueError:
        sys.exit(f"erro: data inválida '{s}' (use AAAA-MM-DD, dd/mm, hoje, ontem, amanha)")


def ptime(s):
    m = re.fullmatch(r"(\d{1,2})(?::|h)?(\d{2})?", s or "")
    if not m:
        sys.exit(f"erro: hora inválida '{s}' (use HH:MM)")
    return f"{int(m.group(1)):02d}:{int(m.group(2) or 0):02d}"


def pnum(s, what="número"):
    try:
        return float(str(s).replace(",", "."))
    except ValueError:
        sys.exit(f"erro: {what} inválido '{s}'")


def note(kind, text, ref_table=None, ref_id=None):
    bot(f"insert into bot_notes (kind, text, ref_table, ref_id, source) values ({lit(kind)}, {lit(text)}, "
        f"{lit(ref_table)}, {lit(ref_id)}::uuid, 'bot')")


# ---------------------------------------------------------------- leitura
def nz(v):
    """Número vindo da API (texto) → float; None fica None."""
    return None if v is None or v == "" else float(v)


def week_reading(done, gmin, gmax, current):
    """Mesma leitura do app (web/src/lib/training.ts weekReading)."""
    if done > gmax:
        return f"acima do máximo ({gmax})"
    if done >= gmin:
        return "no máximo da faixa" if done == gmax else "na faixa"
    left = gmin - done
    return (f"falta 1 para o mínimo" if left == 1 else f"faltam {left} para o mínimo") if current else "abaixo do mínimo"


def week_goal_line(d=None):
    """'Treinos na semana: 3/4 · faixa 4–9 · falta 1 para o mínimo · 2 semanas seguidas no mínimo' (v_training_weeks)."""
    where = f"{lit(d)}::date between week_start and week_end" if d else "is_current"
    r = bot(f"select week_start, week_end, is_current, done, missed, goal_min, goal_max, streak_weeks, by_modality::text as mods "
            f"from v_training_weeks where {where}")
    if not r:
        return "Treinos na semana: 0 (sem registro nessa semana)"
    r = r[0]
    done, gmin, gmax = int(r["done"]), int(r["goal_min"]), int(r["goal_max"])
    cur = str(r["is_current"]).lower() in ("true", "t")
    parts = [f"{done}/{gmin} · faixa {gmin}–{gmax}", week_reading(done, gmin, gmax, cur)]
    if int(r["missed"]):
        parts.append(f"{r['missed']} falta(s)")
    st = int(r["streak_weeks"])
    if st:
        parts.append(f"{st} semana(s) seguida(s) no mínimo")
    mods = json.loads(r["mods"] or "{}")
    if mods:
        parts.append(", ".join(f"{k} {v}" for k, v in sorted(mods.items())))
    return f"Treinos na semana ({r['week_start']} a {r['week_end']}): " + " · ".join(parts)


def cmd_today(a):
    table(bot("select to_char(start_time,'HH24:MI') as hora, title, modality_label as modalidade, plan_kind as tipo, "
              "coalesce(session_status, case when active then 'pendente' else 'pulado' end) as status, "
              "exercise_count as exs, motivo from v_today order by start_time"))


def cmd_week(a):
    _, o = opts(a, bools=("next",))
    if o.get("next"):
        rows = bot("select date, to_char(start_time,'HH24:MI') as hora, title, plan_kind as tipo, "
                   "case when active then coalesce(session_status,'') else 'pulado' end as status, motivo "
                   "from plan_with_sessions(week_start(today_sp()) + 7, week_start(today_sp()) + 13) order by date, start_time")
    else:
        rows = bot("select date, to_char(start_time,'HH24:MI') as hora, title, plan_kind as tipo, "
                   "case when active then coalesce(session_status,'') else 'pulado' end as status, motivo "
                   "from v_week order by date, start_time")
    if not o.get("next"):
        print(week_goal_line())
        print("(a grade é plano flexível: qualquer atividade feita conta para a meta)")
    table(rows)


def cmd_evo(a):
    print("# recomposição (v_recomposition)")
    show(bot("select weight_now_kg, weight_delta_kg, weight_pace_pct_week, weight_arrow, waist_now_cm, waist_delta_cm, "
             "waist_arrow, strength_delta_pct, strength_n_exercises, strength_arrow, reading, reading_text from v_recomposition"))
    print("# peso (últimos 14 dias com pesagem)")
    table(bot("select date, peso_kg, avg_7d, n_7d, delta_7d, pace_pct_week, above_cap from v_weight_trend order by date desc limit 14"))
    print("# PRs (últimos 14 dias)")
    table(bot("select date, exercise_name, kg, reps, e1rm, is_load_pr, is_e1rm_pr from v_prs "
              "where is_pr and date >= today_sp() - 14 order by date desc, logged_at desc limit 20"))
    print("# meta semanal (v_training_weeks: feito + parcial, qualquer modalidade)")
    print(week_goal_line())
    table(bot("select week_start as semana, done || '/' || goal_min || ' (' || goal_min || '–' || goal_max || ')' as treinos, "
              "status, missed as faltas, streak_weeks as sequencia, best_streak_weeks as melhor "
              "from v_training_weeks order by week_start desc limit 6"))


def zone_sql(g, lo, mid, hi):
    """Zona de um macro em SQL (mesma regra do app): abaixo < mín ≤ ok < ideal ≤ ideal ≤ teto < acima."""
    return (f"case when {g} is null or {lo} is null or {mid} is null or {hi} is null then null when {g} < {lo} then 'abaixo' "
            f"when {g} < {mid} then 'ok' when {g} <= {hi} then 'ideal' else 'acima' end")


def cmd_summary(a):
    pos, o = opts(a, flags=("n",))
    unit = (pos[0] if pos else "week")
    n = int(o.get("n", 2))
    month = unit.startswith("m")
    view = "v_monthly_summary" if month else "v_weekly_summary"
    # treinos = sessões feito + parcial no período (qualquer modalidade, mesma regra da meta semanal);
    # a aderência à grade (planned/done) e a creatina saíram dos resumos em 11/11/2026
    show(bot(
        f"select s.period_start, s.period_end, (today_sp() between s.period_start and s.period_end) as em_andamento, "
        f"x.treinos, g.goal_min || '–' || g.goal_max as faixa_semana, "
        # semana: o próprio número; mês: ritmo por semana nos dias já vividos (mês em andamento não divide pelo mês todo)
        f"case when s.days_in_period > 7 then round(x.treinos / ((least(s.period_end, today_sp()) - s.period_start + 1) / 7.0), 1) end as treinos_por_semana, "
        f"case when s.days_in_period <= 7 then "
        f"       case when x.treinos > g.goal_max then 'acima do máximo' when x.treinos >= g.goal_min then 'na faixa' "
        f"            when today_sp() between s.period_start and s.period_end then 'faltam ' || (g.goal_min - x.treinos) || ' para o mínimo' "
        f"            else 'abaixo do mínimo' end "
        f"     else case when x.treinos / ((least(s.period_end, today_sp()) - s.period_start + 1) / 7.0) > g.goal_max then 'média acima do máximo' "
        f"               when x.treinos / ((least(s.period_end, today_sp()) - s.period_start + 1) / 7.0) >= g.goal_min then 'média na faixa' "
        f"               else 'média abaixo do mínimo' end end as meta, "
        f"x.faltas, x.por_modalidade, s.n_prs, s.n_sets, round(s.volume_kg) as volume_kg, "
        # saldo e macros: só dias na conta (fechados, com refeição e basal, diário completo; v_day_targets), igual ao app
        f"m.dias || '/' || s.days_in_period as dias_na_conta, m.fora as fora_da_conta, "
        f"m.saldo_real, m.meta as meta_acumulada, m.saldo_real - m.meta as vs_meta, m.kcal_media, "
        f"m.p as proteina_media_g, {zone_sql('m.p', 'm.p_min', 'm.p_ideal', 'm.p_cap')} as proteina_zona, "
        f"m.p_min || ' / ' || m.p_ideal || '–' || m.p_cap as proteina_min_ideal_g, "
        f"m.c as carbo_media_g, {zone_sql('m.c', 'm.c_floor', 'm.c_min', 'm.c_max')} as carbo_zona, "
        f"m.c_floor || ' / ' || m.c_min || '–' || m.c_max as carbo_min_ideal_g, "
        f"m.f as gordura_media_g, {zone_sql('m.f', 'm.f_floor', 'm.f_min', 'm.f_max')} as gordura_zona, "
        f"m.f_floor || ' / ' || m.f_min || '–' || m.f_max as gordura_min_ideal_g, "
        f"s.weight_avg7_end, s.weight_delta_kg, s.waist_last_cm "
        f"from {view} s "
        f"cross join (select coalesce(max(goal_min), 4) as goal_min, coalesce(max(goal_max), 9) as goal_max from v_training_weeks where is_current) g "
        f"cross join lateral (select count(*) filter (where t.day_state = 'na_conta')::int as dias, "
        f"  nullif(concat_ws(', ', case when count(*) filter (where t.day_state = 'incompleto') > 0 then count(*) filter (where t.day_state = 'incompleto') || ' incompleto(s)' end, "
        f"    case when count(*) filter (where t.day_state = 'sem_refeicao') > 0 then count(*) filter (where t.day_state = 'sem_refeicao') || ' sem refeição' end, "
        f"    case when count(*) filter (where t.day_state = 'hoje') > 0 then 'hoje em andamento' end), '') as fora, "
        f"  sum(t.balance_kcal) filter (where t.day_state = 'na_conta') as saldo_real, "
        f"  sum(t.target_balance_kcal) filter (where t.day_state = 'na_conta') as meta, "
        f"  round(avg(t.food_kcal) filter (where t.day_state = 'na_conta')) as kcal_media, "
        + "".join(f"  round(avg(t.{c}) filter (where t.day_state = 'na_conta'), {d}) as {a}, " for c, a, d in (
            ("protein_g", "p", 1), ("protein_min_g", "p_min", 0), ("protein_ideal_g", "p_ideal", 0), ("protein_cap_g", "p_cap", 0),
            ("carb_g", "c", 1), ("carb_floor_g", "c_floor", 0), ("carb_min_g", "c_min", 0), ("carb_max_g", "c_max", 0),
            ("fat_g", "f", 1), ("fat_floor_g", "f_floor", 0), ("fat_min_g", "f_min", 0)))
        + f"  round(avg(t.fat_max_g) filter (where t.day_state = 'na_conta')) as f_max "
        f"  from v_day_targets t where t.date between s.period_start and s.period_end) m "
        f"cross join lateral (select count(*) filter (where z.status in ('feito', 'parcial'))::int as treinos, "
        f"  count(*) filter (where z.status = 'faltou')::int as faltas, "
        f"  (select jsonb_object_agg(m.modality, m.n) from (select y.modality, count(*) as n from sessions y "
        f"   where y.status in ('feito', 'parcial') and y.date between s.period_start and s.period_end group by y.modality) m) as por_modalidade "
        f"  from sessions z where z.date between s.period_start and s.period_end) x "
        f"order by s.period_start desc limit {n}"))


def cmd_day(a):
    d = pdate(a[0] if a else None)
    print(week_goal_line(d))
    table(bot(f"select left(id::text, 8) as id, meal as refeicao, description as item, grams as g, portion_label as medida, "
              f"round(kcal) as kcal, round(protein_g,1) as p, round(carb_g,1) as c, round(fat_g,1) as g_, estimated as est "
              f"from food_logs where date = {lit(d)} order by logged_at"))
    totals(d)


PROTEIN_ZONE = {"abaixo": "abaixo do mínimo", "ok": "mínimo ok", "ideal": "ideal", "acima": "acima do teto útil"}
MACRO_ZONE = {"abaixo": "abaixo do mínimo", "ok": "mínimo ok", "ideal": "ideal", "acima": "acima da faixa"}


def kn(v):
    """1234.4 → '1.234' (kcal/g inteiros, separador pt-BR)."""
    return "–" if v is None else f"{round(float(v)):,}".replace(",", ".")


def signed(v):
    v = round(float(v))
    return ("+" if v > 0 else "−" if v < 0 else "±") + kn(abs(v))


def protein_zone(g, t):
    """Zonas de v_protein_target (docs/proteina.md): abaixo < mín ≤ ok < ideal ≤ ideal ≤ teto < acima."""
    if t.get("min_g") is None:
        return None
    if g < nz(t["min_g"]):
        return "abaixo"
    if g < nz(t["ideal_g"]):
        return "ok"
    return "ideal" if g <= nz(t["cap_g"]) else "acima"


def totals(d):
    """Total do dia por v_day_targets: meta fixa (saldo-alvo), pode consumir, resta e macros por zona (docs/macros.md)."""
    r = bot(f"select * from v_day_targets where date = {lit(d)}")
    if not r:
        n = bot(f"select coalesce(sum(kcal),0) as kcal from food_logs where date = {lit(d)}")
        print(f"total {d}: {kn(n[0]['kcal'])} kcal (sem dados de gasto nesse dia)")
        return
    r = {k: (None if v == "" else v) for k, v in r[0].items()}   # FIT_PSQL devolve NULL como texto vazio
    is_today = d == today().isoformat()
    food, allow, tgt = nz(r["food_kcal"]), nz(r["allowance_kcal"]), nz(r["target_balance_kcal"])
    head = f"total {d}: comida {kn(food)} kcal"
    if allow is not None:
        rem = allow - food
        head += f" · pode consumir {kn(allow)} · {'resta' if rem >= 0 else 'passou'} {kn(abs(rem))}"
    else:
        head += " · sem permissão (falta o basal: fit perfil)"
    print(head)
    if tgt is not None:
        print(f"  meta do dia: saldo {signed(tgt)} kcal, fixa (treinar aumenta a permissão, não a meta)")
    if r["allowance_basis"] == "gasto":
        ex = nz(r["exercise_kcal"]) or 0
        parts = f"basal {kn(r['bmr_kcal'])} + rotina {kn(r['daily_life_kcal'])}" + (f" + treino {kn(ex)}" + (" (estimado)" if r["is_estimate"] in (True, "true", "t") else "") if ex else "")
        print(f"  pode consumir = {parts}{f' {chr(8722) if tgt < 0 else chr(43)} {kn(abs(tgt))}' if tgt else ''}")
    elif r["allowance_basis"] == "fixa":
        print("  pode consumir = meta fixa goals.kcal_target (sem basal)")
    if r["day_state"] == "incompleto":
        print("  diário incompleto: o dia fica fora do saldo acumulado e das médias")
    def zone_txt(z, labels):
        if not z:
            return None
        return labels[z] + (" até agora" if z == "abaixo" and is_today else "")
    g = {k: nz(r[k]) or 0 for k in ("protein_g", "carb_g", "fat_g")}
    pz = zone_txt(r["protein_zone"], PROTEIN_ZONE)
    if r["protein_min_g"] is None:
        print(f"  proteína {kn(g['protein_g'])} g (faixa depois da 1ª pesagem)")
    else:
        ref = f", ref. {nz(r['ref_weight_kg']):g} kg" if r.get("ref_weight_kg") is not None else ""
        print(f"  proteína {kn(g['protein_g'])} g{f' · {pz}' if pz else ''} (mínimo {kn(r['protein_min_g'])} · ideal {kn(r['protein_ideal_g'])}–{kn(r['protein_cap_g'])} g{ref})")
    cz = zone_txt(r["carb_zone"], MACRO_ZONE)
    if r["carb_min_g"] is None:
        print(f"  carbo {kn(g['carb_g'])} g (faixa quando houver permissão do dia e peso)")
    else:
        print(f"  carbo {kn(g['carb_g'])} g{f' · {cz}' if cz else ''} (mínimo {kn(r['carb_floor_g'])} · ideal {kn(r['carb_min_g'])}–{kn(r['carb_max_g'])} g: o que sobra da permissão)")
    fz = zone_txt(r["fat_zone"], MACRO_ZONE)
    if r["fat_min_g"] is None:
        print(f"  gordura {kn(g['fat_g'])} g (faixa quando houver permissão do dia)")
    else:
        print(f"  gordura {kn(g['fat_g'])} g{f' · {fz}' if fz else ''} (mínimo {kn(r['fat_floor_g'])} · ideal {kn(r['fat_min_g'])}–{kn(r['fat_max_g'])} g = 20–35 % da permissão)")


def cmd_food(a):
    pos, o = opts(a, flags=("limit",))
    if not pos:
        sys.exit("uso: fit food <busca>")
    q = " ".join(pos)
    table(bot(f"select code, fonte, name, kcal, protein_g as p, carb_g as c, fat_g as g, portions from food_search({lit(q)}, {int(o.get('limit', 8))})"))


def cmd_notes(a):
    _, o = opts(a, flags=("limit",))
    table(bot(f"select to_char(created_at at time zone 'America/Sao_Paulo', 'DD/MM HH24:MI') as quando, kind, text "
              f"from bot_notes order by created_at desc limit {int(o.get('limit', 10))}"))


def cmd_sessions(a):
    _, o = opts(a, flags=("limit",))
    table(bot(f"select left(id::text,8) as id, date, title, status, n_sets as series, round(volume_kg) as volume, n_prs as prs, source "
              f"from v_sessions order by date desc, started_at desc nulls last limit {int(o.get('limit', 10))}"))


# ---------------------------------------------------------------- treino
def plan_item(d, time=None, title=None, only_pending=False):
    rows = bot(f"select to_char(start_time,'HH24:MI') as hora, * from plan_with_sessions({lit(d)}, {lit(d)}) where active order by start_time")
    if time:
        rows = [r for r in rows if r["hora"] == time]
    if title:
        t = title.lower()
        rows = [r for r in rows if t in r["title"].lower() or t in (r["modality"] or "")]
    if only_pending:
        pend = [r for r in rows if not r["session_status"]]
        rows = pend or rows
    return rows


def cmd_session(a):
    pos, o = opts(a, flags=("date", "time", "title", "note"))
    if not pos or pos[0] not in ("feito", "faltou", "parcial", "fiz", "faltei"):
        sys.exit("uso: fit session feito|faltou|parcial [--date d] [--time HH:MM | --title t] [--note t]")
    status = {"fiz": "feito", "faltei": "faltou"}.get(pos[0], pos[0])
    d = pdate(o.get("date"))
    rows = plan_item(d, ptime(o["time"]) if "time" in o else None, o.get("title"), only_pending=True)
    if not rows:
        sys.exit(f"erro: nada planejado em {d} com esse filtro (use fit add para algo fora da grade)")
    if len(rows) > 1 and "time" not in o and "title" not in o:
        pend = [r for r in rows if not r["session_status"]]
        if len(pend) != 1:
            table(rows, ["hora", "title", "session_status"])
            sys.exit("erro: mais de uma atividade; use --time ou --title")
        rows = pend
    r = rows[0]
    if r["session_id"]:
        out = bot(f"update sessions set status = {lit(status)}, note = coalesce({lit(o.get('note'))}, note), source = 'bot' "
                  f"where id = {lit(r['session_id'])} returning id, date, status")
    else:
        out = bot(f"insert into sessions (date, modality, template_id, slot_id, override_id, status, note, source) values ("
                  f"{lit(d)}, {lit(r['modality'])}, {lit(r['template_id'])}::uuid, {lit(r['slot_id'])}::uuid, {lit(r['override_id'])}::uuid, "
                  f"{lit(status)}, {lit(o.get('note'))}, 'bot') returning id, date, status")
    print(f"{r['hora']} {r['title']}: {status}")
    show(out)


def exercise(slug):
    r = bot(f"select id, name from exercises where slug = {lit(slug)}")
    if not r:
        cands = bot(f"select slug, name from exercises where slug ilike {lit('%' + slug + '%')} or name ilike {lit('%' + slug + '%')} order by name")
        if cands:
            table(cands)
        sys.exit(f"erro: exercício '{slug}' não encontrado (use o slug)")
    return r[0]


def cmd_log_set(a):
    pos, o = opts(a, flags=("set", "date", "rir", "session"), bools=("warmup",))
    if len(pos) != 3:
        sys.exit("uso: fit log-set <exercicio_slug> <kg> <reps> [--set n] [--date d] [--rir r] [--warmup] [--session id]")
    ex = exercise(pos[0])
    kg, reps = pnum(pos[1], "kg"), int(pnum(pos[2], "reps"))
    d = pdate(o.get("date"))
    sid = o.get("session")
    if not sid:
        # sessão do dia cuja ficha contém o exercício (ou que já tem séries dele)
        s = bot(f"select s.id from sessions s where s.date = {lit(d)} and s.status <> 'faltou' and ("
                f"exists (select 1 from template_exercises te where te.template_id = s.template_id and te.exercise_id = {lit(ex['id'])}) "
                f"or exists (select 1 from set_logs sl where sl.session_id = s.id and sl.exercise_id = {lit(ex['id'])})) "
                f"order by s.created_at desc limit 1")
        if s:
            sid = s[0]["id"]
        else:
            tpl = bot(f"select p.template_id, p.slot_id, p.override_id from plan_with_sessions({lit(d)}, {lit(d)}) p "
                      f"join template_exercises te on te.template_id = p.template_id and te.exercise_id = {lit(ex['id'])} "
                      f"where p.active limit 1")
            if not tpl:
                tpl = bot(f"select te.template_id, null as slot_id, null as override_id from template_exercises te "
                          f"where te.exercise_id = {lit(ex['id'])} limit 1")
            t = tpl[0] if tpl else {"template_id": None, "slot_id": None, "override_id": None}
            sid = bot(f"insert into sessions (date, modality, template_id, slot_id, override_id, status, source) values ("
                      f"{lit(d)}, 'musculacao', {lit(t['template_id'])}::uuid, {lit(t['slot_id'])}::uuid, {lit(t['override_id'])}::uuid, "
                      f"'feito', 'bot') returning id")[0]["id"]
            print(f"sessão criada: {sid}")
    n = o.get("set")
    set_no = int(n) if n else f"(select coalesce(max(set_number), 0) + 1 from set_logs where session_id = {lit(sid)} and exercise_id = {lit(ex['id'])})"
    out = bot(f"insert into set_logs (session_id, exercise_id, set_number, kg, reps, rir, warmup, source) values ("
              f"{lit(sid)}, {lit(ex['id'])}, {set_no}, {kg}, {reps}, {lit(o.get('rir'))}::numeric, {str(bool(o.get('warmup'))).lower()}, 'bot') "
              f"returning set_number, kg, reps")
    print(f"{ex['name']}: série {out[0]['set_number']} = {kg:g} kg × {reps}")
    pr = bot(f"select is_load_pr, is_e1rm_pr from v_prs where session_id = {lit(sid)} and exercise_id = {lit(ex['id'])} "
             f"and set_number = {out[0]['set_number']}")
    if pr and (pr[0]["is_load_pr"] or pr[0]["is_e1rm_pr"]):
        print("PR! (" + ", ".join(k for k, v in (("carga", pr[0]["is_load_pr"]), ("1RM est.", pr[0]["is_e1rm_pr"])) if v) + ")")


def cmd_carga(a):
    pos, o = opts(a, flags=("template", "motivo"))
    if len(pos) != 2:
        sys.exit("uso: fit carga <exercicio_slug> <kg> [--template slug] [--motivo t]")
    ex = exercise(pos[0])
    kg = pnum(pos[1], "kg")
    tf = f" and template_id = (select id from workout_templates where slug = {lit(o['template'])})" if "template" in o else ""
    out = bot(f"update template_exercises set carga_alvo = {kg}, source = 'bot' where exercise_id = {lit(ex['id'])}{tf} "
              f"returning (select slug from workout_templates w where w.id = template_id) as ficha, carga_alvo")
    if not out:
        sys.exit("erro: exercício não está em nenhuma ficha (com esse filtro)")
    note("carga", f"{ex['name']}: carga-alvo {kg:g} kg" + (f". {o['motivo']}" if o.get("motivo") else "."), "template_exercises")
    show(out)


def cmd_target(a):
    pos, o = opts(a, flags=("kg", "reps", "motivo"))
    if len(pos) < 2:
        sys.exit("uso: fit target <ficha_slug|id> <exercicio> [--kg X] [--reps N] [--motivo t]")
    tref, q = pos[0], " ".join(pos[1:])
    tw = f"t.id::text = {lit(tref)}" if re.fullmatch(r"[0-9a-f-]{36}", tref) else f"t.slug = {lit(tref)}"
    base = (f"from template_exercises te join workout_templates t on t.id = te.template_id join exercises e on e.id = te.exercise_id "
            f"where {tw} and (e.slug = {lit(q)} or f_unaccent(lower(e.name)) like {lit('%' + norm(q) + '%')})")
    rows = bot(f"select te.id, t.name as ficha, e.name as exercicio, te.carga_alvo, te.reps_alvo, te.reps_min, te.reps_max {base} order by te.position")
    exact = [r for r in rows if norm(r["exercicio"]) == norm(q)]
    rows = exact or rows
    if len(rows) != 1:
        if rows:
            table(rows, ["ficha", "exercicio", "carga_alvo", "reps_alvo"])
        sys.exit(f"erro: {len(rows)} exercícios batem com '{q}' nessa ficha" if rows else f"erro: '{q}' não está na ficha {tref}")
    r = rows[0]
    sets, desc = [], []
    if "kg" in o:
        kg = pnum(o["kg"], "kg")
        sets.append(f"carga_alvo = {kg}")
        desc.append(f"{kg:g} kg")
    if "reps" in o:
        reps = int(pnum(o["reps"], "reps"))
        if reps <= 0:
            sys.exit("erro: --reps precisa ser > 0")
        sets.append(f"reps_alvo = {reps}")
        desc.append(f"{reps} reps")
    if sets:
        r = bot(f"update template_exercises set {', '.join(sets)}, source = 'bot' where id = {lit(r['id'])} "
                f"returning (select name from workout_templates w where w.id = template_id) as ficha, "
                f"(select name from exercises x where x.id = exercise_id) as exercicio, carga_alvo, reps_alvo, reps_min, reps_max")[0]
        note("carga", f"{r['ficha']} · {r['exercicio']}: alvo {' × '.join(desc)}" + (f". {o['motivo']}" if o.get("motivo") else "."), "template_exercises")
    table([r], ["ficha", "exercicio", "carga_alvo", "reps_alvo", "reps_min", "reps_max"])


# ---------------------------------------------------------------- agenda
def find_occurrence(d, t):
    rows = bot(f"select * from plan_between({lit(d)}, {lit(d)}) where active and start_time = {lit(t)}::time")
    if not rows:
        sys.exit(f"erro: nada planejado em {d} às {t}")
    return rows[0]


def skip_occurrence(occ, motivo):
    if occ["plan_kind"] == "adicionado":
        bot(f"delete from schedule_overrides where id = {lit(occ['override_id'])}")
    elif occ["plan_kind"] == "substituido":
        bot(f"update schedule_overrides set action = 'skip', motivo = {lit(motivo)}, source = 'bot' where id = {lit(occ['override_id'])}")
    else:
        bot(f"insert into schedule_overrides (date, action, slot_id, motivo, source) values ({lit(occ['date'])}, 'skip', "
            f"{lit(occ['slot_id'])}, {lit(motivo)}, 'bot')")


def cmd_skip(a):
    pos, o = opts(a, flags=("motivo",))
    if len(pos) != 2:
        sys.exit("uso: fit skip <data> <HH:MM> [--motivo t]")
    d, t = pdate(pos[0]), ptime(pos[1])
    occ = find_occurrence(d, t)
    skip_occurrence(occ, o.get("motivo"))
    note("remarcacao", f"{occ['title']} de {d} {t} pulado" + (f": {o['motivo']}" if o.get("motivo") else "."), "schedule_overrides")
    print(f"pulado: {d} {t} {occ['title']}")


def cmd_move(a):
    pos, o = opts(a, flags=("to", "motivo"))
    # fit move <data> <HH:MM> --to <data> <HH:MM>  (o --to consome só a data; a hora nova é o 3º posicional)
    if len(pos) != 3 or "to" not in o:
        sys.exit("uso: fit move <data> <HH:MM> --to <data> <HH:MM> [--motivo t]")
    d, t = pdate(pos[0]), ptime(pos[1])
    nd, nt = pdate(o["to"]), ptime(pos[2])
    occ = find_occurrence(d, t)
    motivo = o.get("motivo") or f"Remarcado de {d} {t}."
    skip_occurrence(occ, f"Remarcado para {nd} {nt}." + (f" {o['motivo']}" if o.get("motivo") else ""))
    bot(f"insert into schedule_overrides (date, action, start_time, duration_min, modality, template_id, title, motivo, source) values ("
        f"{lit(nd)}, 'add', {lit(nt)}::time, {occ['duration_min']}, {lit(occ['modality'])}, {lit(occ['template_id'])}::uuid, "
        f"{lit(occ['title'])}, {lit(motivo)}, 'bot')")
    note("remarcacao", f"{occ['title']}: {d} {t} → {nd} {nt}" + (f". {o['motivo']}" if o.get("motivo") else "."), "schedule_overrides")
    print(f"remarcado: {occ['title']} {d} {t} → {nd} {nt}")


def cmd_add(a):
    pos, o = opts(a, flags=("template", "title", "dur", "motivo"))
    if len(pos) != 3 or pos[2] not in MODALITIES:
        sys.exit(f"uso: fit add <data> <HH:MM> <{'|'.join(MODALITIES)}> [--template slug] [--title t] [--dur min] [--motivo t]")
    d, t, m = pdate(pos[0]), ptime(pos[1]), pos[2]
    tpl = f"(select id from workout_templates where slug = {lit(o['template'])})" if "template" in o else "null"
    out = bot(f"insert into schedule_overrides (date, action, start_time, duration_min, modality, template_id, title, motivo, source) values ("
              f"{lit(d)}, 'add', {lit(t)}::time, {int(o.get('dur', 60))}, {lit(m)}, {tpl}, {lit(o.get('title'))}, {lit(o.get('motivo'))}, 'bot') "
              f"returning id, date, start_time, title")
    note("remarcacao", f"Adicionado {o.get('title') or m} em {d} {t}" + (f": {o['motivo']}" if o.get("motivo") else "."), "schedule_overrides")
    show(out)


# ---------------------------------------------------------------- corpo
BODY_FIELDS = {"cintura": "cintura_cm", "abdomen": "abdomen_cm", "quadril": "quadril_cm", "peito": "peito_cm",
               "braco": "braco_cm", "coxa": "coxa_cm", "gordura": "gordura_pct"}


def cmd_body(a):
    pos, o = opts(a, flags=tuple(BODY_FIELDS) + ("date", "nota"))
    vals = {}
    if pos:
        vals["peso_kg"] = pnum(pos[0], "peso")
    if len(pos) > 1:
        vals["cintura_cm"] = pnum(pos[1], "cintura")
    for k, col in BODY_FIELDS.items():
        if k in o:
            vals[col] = pnum(o[k], k)
    if not vals and "nota" not in o:
        sys.exit("uso: fit body [peso] [--cintura x] [--abdomen x] ... [--date d] [--nota t]")
    d = pdate(o.get("date"))
    cols = list(vals) + (["nota"] if "nota" in o else [])
    v = [str(vals[c]) for c in vals] + ([lit(o["nota"])] if "nota" in o else [])
    upd = ", ".join(f"{c} = excluded.{c}" for c in cols)
    out = bot(f"insert into body_metrics (date, {', '.join(cols)}, source) values ({lit(d)}, {', '.join(v)}, 'bot') "
              f"on conflict (date) do update set {upd}, source = 'bot' "
              f"returning date, peso_kg, cintura_cm, abdomen_cm, quadril_cm, peito_cm, braco_cm, coxa_cm, gordura_pct")
    table(out)
    if "peso_kg" in vals:
        t = bot(f"select avg_7d, n_7d, delta_7d from v_weight_trend where date = {lit(d)}")
        if t:
            print(f"média 7d: {t[0]['avg_7d']} kg ({t[0]['n_7d']} pesagens)" + (f", Δ7d {t[0]['delta_7d']}" if t[0]['delta_7d'] is not None else ""))


def service_key():
    k = os.environ.get("SUPABASE_SERVICE_ROLE_KEY")
    if not k and os.path.exists(KEYS_FILE):
        for line in open(KEYS_FILE):
            if line.startswith("SUPABASE_SERVICE_ROLE_KEY="):
                k = line.split("=", 1)[1].strip().strip('"')
    if not k:
        sys.exit("erro: SUPABASE_SERVICE_ROLE_KEY ausente (necessária só para subir fotos no Storage)")
    return k


def upload(path, data, bucket="progress"):
    url = f"https://{REF}.supabase.co/storage/v1/object/{bucket}/{urllib.parse.quote(path)}"
    key = service_key()
    req = urllib.request.Request(url, data=data, method="POST", headers={
        "Authorization": "Bearer " + key, "apikey": key, "Content-Type": "image/jpeg", "x-upsert": "true",
        "Cache-Control": "private, max-age=600"})
    try:
        urllib.request.urlopen(req, timeout=120).read()
    except urllib.error.HTTPError as e:
        sys.exit(f"erro {e.code} ao subir {path}: {e.read()[:200]!r}")


def store_photo(file, stem, bucket):
    """Remove EXIF, sobe <stem>.jpg (1600 px) e <stem>-thumb.jpg (400 px); devolve os dois caminhos."""
    try:
        from PIL import Image, ImageOps
    except ImportError:
        sys.exit("erro: Pillow não instalado (pip install pillow)")
    import io
    if not os.path.isfile(file):
        sys.exit(f"erro: arquivo não encontrado: {file}")
    with Image.open(file) as im:
        im = ImageOps.exif_transpose(im).convert("RGB")   # aplica a rotação e descarta o EXIF (GPS, aparelho)
        full = im.copy()
        full.thumbnail((1600, 1600))
        thumb = im.copy()
        thumb.thumbnail((400, 400))
    def jpeg(img, q):
        b = io.BytesIO()
        img.save(b, "JPEG", quality=q, optimize=True, progressive=True)   # sem exif=
        return b.getvalue()
    upload(f"{stem}.jpg", jpeg(full, 82), bucket)
    upload(f"{stem}-thumb.jpg", jpeg(thumb, 78), bucket)
    return f"{stem}.jpg", f"{stem}-thumb.jpg"


def cmd_photo(a):
    pos, o = opts(a, flags=("pose", "date", "nota"))
    if len(pos) != 1 or o.get("pose") not in ("frente", "lado", "costas"):
        sys.exit("uso: fit photo <arquivo> --pose frente|lado|costas [--date d] [--nota t]")
    import uuid
    d = pdate(o.get("date"))
    path, thumb = store_photo(pos[0], f"{d[:7]}/{d}-{o['pose']}-{uuid.uuid4().hex[:8]}", "progress")
    out = bot(f"insert into progress_photos (date, pose, path, thumb_path, nota, source) values ({lit(d)}, {lit(o['pose'])}, "
              f"{lit(path)}, {lit(thumb)}, {lit(o.get('nota'))}, 'bot') returning id, date, pose, path")
    show(out)


def cmd_meal_photo(a):
    pos, o = opts(a, flags=("date", "note"))
    if len(pos) != 2 or not pos[1].strip():
        sys.exit("uso: fit meal-photo <arquivo> <refeicao> [--date d] [--note t]")
    import uuid
    file, meal, d = pos[0], pos[1].strip(), pdate(o.get("date"))
    slug = re.sub(r"[^a-z0-9]+", "-", norm(meal)).strip("-") or "refeicao"
    path, thumb = store_photo(file, f"{d[:7]}/{d}-{slug}-{uuid.uuid4().hex[:8]}", "meals")
    out = bot(f"insert into meal_photos (date, meal, path, thumb_path, note, source) values ({lit(d)}, {lit(meal)}, "
              f"{lit(path)}, {lit(thumb)}, {lit(o.get('note'))}, 'bot') returning id, date, meal, path, thumb_path")
    show(out)
    n = bot(f"select count(*) as n from food_logs where date = {lit(d)} and meal = {lit(meal)}")[0]["n"]
    if not n:
        print(f"aviso: nenhum item em food_logs para '{meal}' em {d}; confira se o nome da refeição é o mesmo dos itens")


# ---------------------------------------------------------------- nutrição
def resolve_food(ref):
    if ref.startswith(("taco:", "tbca:", "custom:")):
        r = bot(f"select id, code, name, kcal, protein_g, carb_g, fat_g from foods where code = {lit(ref)}")
        if not r:
            sys.exit(f"erro: alimento {ref} não existe")
        return r[0]
    r = bot(f"select f.id, f.code, f.name, f.kcal, f.protein_g, f.carb_g, f.fat_g from food_search({lit(ref)}, 5) s join foods f on f.code = s.code")
    if not r:
        sys.exit(f"erro: nada encontrado para '{ref}' (veja fit food)")
    exact = [x for x in r if x["name"].lower() == ref.lower()]
    if exact:
        return exact[0]
    words = norm(ref).split()
    full = [x for x in r if all(w in norm(x["name"]) for w in words)]
    if len(full) == 1:
        return full[0]
    table(r, ["code", "name", "kcal"])
    sys.exit(f"erro: '{ref}' é ambíguo; use o código")


def norm(t):
    import unicodedata
    return "".join(c for c in unicodedata.normalize("NFD", t.lower()) if unicodedata.category(c) != "Mn")


def parse_item(item):
    if item.startswith("desc="):
        kv = dict(p.split("=", 1) for p in item.split(";") if "=" in p)
        return {"free": True, "desc": kv["desc"], "grams": pnum(kv["g"]) if "g" in kv else None,
                "kcal": pnum(kv.get("kcal", 0)), "p": pnum(kv.get("p", 0)), "c": pnum(kv.get("c", 0)), "f": pnum(kv.get("f", 0))}
    if "=" not in item:
        sys.exit(f"erro: item '{item}' sem quantidade (use alimento=150g)")
    ref, qty = item.rsplit("=", 1)
    food = resolve_food(ref.strip())
    qty = qty.strip()
    m = re.fullmatch(r"([\d.,]+)\s*g", qty)
    if m:
        grams, label, n = pnum(m.group(1)), None, None
    else:
        m = re.fullmatch(r"([\d.,]+)?\s*(?:x\s*)?(.+)", qty)
        n = pnum(m.group(1)) if m.group(1) else 1.0
        label = m.group(2).strip()
        p = bot(f"select label, grams from food_portions where food_id = {lit(food['id'])} and label ilike {lit(label)}")
        if not p:
            p = bot(f"select label, grams from food_portions where food_id = {lit(food['id'])} and label ilike {lit('%' + label + '%')}")
        if len(p) != 1:
            opts_ = bot(f"select label, grams from food_portions where food_id = {lit(food['id'])} order by label")
            table(opts_)
            sys.exit(f"erro: medida '{label}' não encontrada para {food['name']} (use gramas ou fit portion)")
        label = p[0]["label"]
        grams = round(n * float(p[0]["grams"]), 1)
    f = grams / 100
    def mac(k):
        return round(float(food[k] or 0) * f, 2)
    return {"free": False, "food": food, "grams": grams, "label": label, "n": n,
            "kcal": mac("kcal"), "p": mac("protein_g"), "c": mac("carb_g"), "f": mac("fat_g")}


def cmd_meal(a):
    pos, o = opts(a, flags=("date", "note"), bools=("estimated",))
    if len(pos) < 2:
        sys.exit('uso: fit meal <refeicao> "<codigo|nome>=<qtd>" [...] [--date d] [--estimated] [--note t]')
    meal, d = pos[0], pdate(o.get("date"))
    items = [parse_item(x) for x in pos[1:]]
    est = "true" if o.get("estimated") else "false"
    vals = []
    for it in items:
        if it["free"]:
            vals.append(f"({lit(d)}, {lit(meal)}, null, {lit(it['desc'])}, {lit(it['grams'])}::numeric, null, null, "
                        f"{it['kcal']}, {it['p']}, {it['c']}, {it['f']}, {est}, {lit(o.get('note'))}, 'bot')")
        else:
            desc = it["food"]["name"]
            vals.append(f"({lit(d)}, {lit(meal)}, {lit(it['food']['id'])}::uuid, {lit(desc)}, {it['grams']}, {lit(it['label'])}, "
                        f"{lit(it['n'] if it['label'] else None)}::numeric, {it['kcal']}, {it['p']}, {it['c']}, {it['f']}, {est}, {lit(o.get('note'))}, 'bot')")
    out = bot("insert into food_logs (date, meal, food_id, description, grams, portion_label, portion_qty, kcal, protein_g, carb_g, fat_g, "
              "estimated, note, source) values " + ", ".join(vals) + " returning left(id::text, 8) as id, description, grams, round(kcal) as kcal, round(protein_g,1) as p")
    table(out)
    totals(d)


def cmd_meal_del(a):
    if len(a) != 1:
        sys.exit("uso: fit meal-del <id (8+ caracteres)>")
    out = bot(f"delete from food_logs where id::text like {lit(a[0] + '%')} returning description, date")
    if len(out) != 1:
        sys.exit(f"erro: {len(out)} itens apagados (use um id mais longo)" if out else "erro: id não encontrado")
    show(out)


def cmd_food_add(a):
    pos, o = opts(a, flags=("fiber", "portion"))
    if len(pos) != 6:
        sys.exit('uso: fit food-add <slug> "<nome>" <kcal> <prot> <carb> <gord> [--fiber x] [--portion "1 un=350"]')
    slug, name = pos[0], pos[1]
    k, p, c, g = (pnum(x) for x in pos[2:6])
    out = bot(f"insert into foods (code, name, category, is_custom, kcal, protein_g, carb_g, fat_g, fiber_g, fonte, source) values ("
              f"{lit('custom:' + slug)}, {lit(name)}, 'Custom', true, {k}, {p}, {c}, {g}, {lit(o.get('fiber'))}::numeric, 'custom', 'bot') "
              f"on conflict (code) do update set name = excluded.name, kcal = excluded.kcal, protein_g = excluded.protein_g, "
              f"carb_g = excluded.carb_g, fat_g = excluded.fat_g, fiber_g = excluded.fiber_g, source = 'bot' returning code, name")
    show(out)
    if "portion" in o:
        label, grams = o["portion"].rsplit("=", 1)
        cmd_portion([f"custom:{slug}", label.strip(), grams.strip()])


# ---------------------------------------------------------------- TBCA sob demanda
TBCA_BASE = "https://www.tbca.net.br/base-dados/"
TBCA_BLOCK = ("erro: a TBCA pediu verificação de bot (403 / reCAPTCHA) e o fit não contorna isso. Tente mais tarde; "
              "se continuar, abra https://www.tbca.net.br no navegador e use fit food-add com os valores da página.")


def tbca_get(path, data=None):
    req = urllib.request.Request(TBCA_BASE + path, data=urllib.parse.urlencode(data).encode() if data else None,
                                 headers={"User-Agent": "fit-cli (app pessoal de nutricao; consulta sob demanda)"})
    try:
        with urllib.request.urlopen(req, timeout=40) as r:
            page = r.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        sys.exit(TBCA_BLOCK if e.code == 403 else f"erro: TBCA respondeu {e.code}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"erro: não consegui acessar a TBCA ({e})")
    if "Bot Verification" in page:
        sys.exit(TBCA_BLOCK)
    return page


def tbca_clean(s):
    import html
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", "", s))).strip()


def tbca_num(s):
    s = s.strip().lower()
    if s == "tr":
        return 0.0
    if "," in s:
        s = s.replace(".", "").replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def tbca_parse_list(page):
    import html
    out = []
    for r in re.findall(r"<tr>(<td>.*?)</tr>", page, flags=re.S):
        tds = re.findall(r"<td>(.*?)</td>", r, flags=re.S)
        href = re.search(r"href='(int_composicao_alimentos\.php\?[^']*)'", r)
        if len(tds) >= 4 and href:
            out.append({"code": tbca_clean(tds[0]), "name": tbca_clean(tds[1]), "group": tbca_clean(tds[3]),
                        "brand": tbca_clean(tds[4]) if len(tds) > 4 else "", "href": html.unescape(href.group(1))})
    return out


def tbca_parse_detail(page):
    """Valores por 100 g + medidas caseiras [(rótulo, gramas)]; None se a página não trouxer kcal/proteína/gordura."""
    header, nut = [], {}
    for r in re.findall(r"<tr.*?</tr>", page, flags=re.S):
        cells = [tbca_clean(c) for c in re.findall(r"<t[hd][^>]*>(.*?)</t[hd]>", r, flags=re.S)]
        if cells and cells[0] == "Componente":
            header = cells
        elif len(cells) >= 3:
            nut[f"{cells[0]}|{cells[1]}"] = cells[2:]
    val = lambda k: tbca_num(nut[k][0]) if k in nut and nut[k] else None
    food = {"kcal": val("Energia|kcal"), "p": val("Proteína|g"), "c": val("Carboidrato total|g"),
            "f": val("Lipídios|g"), "fib": val("Fibra alimentar|g")}
    if food["kcal"] is None or food["p"] is None or food["f"] is None:
        return None
    # medida em mL não tem gramas na página: usa a razão medida/100 g do componente de maior valor
    best = max((v for v in nut.values() if tbca_num(v[0])), key=lambda v: tbca_num(v[0]), default=None)
    portions, seen = [], set()
    for i, lab in enumerate(header[3:]):
        m = re.search(r"\(([\d.,]+)\s*(g|ml)\)\s*$", lab, flags=re.I)
        label = re.sub(r"\s*\([^)]*\)\s*$", "", lab).strip()
        if m and m.group(2).lower() == "g":
            grams = tbca_num(m.group(1))
        else:
            v = tbca_num(best[i + 1]) if best and i + 1 < len(best) else None
            grams = round(v / tbca_num(best[0]) * 100, 1) if v else None
            if m and grams:
                label = f"{label} ({m.group(1)} mL)"
        if grams and grams > 0 and label.lower() not in seen:
            seen.add(label.lower())
            portions.append((label, round(grams, 1)))
    food["portions"] = portions
    return food


def tbca_save(item):
    food = tbca_parse_detail(tbca_get(item["href"]))
    if not food:
        print(f"{item['code']}: a página da TBCA não traz kcal/proteína/gordura; nada cadastrado")
        return False
    code = "tbca:" + item["code"]
    name = re.sub(r",\s*Brasil(?=\s*(\(|$))", "", item["name"], flags=re.I).strip()
    if item["brand"]:
        name += f" ({item['brand']})"
    n = lambda v: "null" if v is None else repr(v)
    out = bot(f"insert into foods (code, name, category, is_custom, kcal, protein_g, carb_g, fat_g, fiber_g, fonte, source) values ("
              f"{lit(code)}, {lit(name)}, {lit(item['group'])}, false, {n(food['kcal'])}, {n(food['p'])}, {n(food['c'])}, {n(food['f'])}, {n(food['fib'])}, 'TBCA', 'bot') "
              f"on conflict (code) do update set name = excluded.name, category = excluded.category, kcal = excluded.kcal, protein_g = excluded.protein_g, "
              f"carb_g = excluded.carb_g, fat_g = excluded.fat_g, fiber_g = excluded.fiber_g, fonte = 'TBCA', source = 'bot' "
              f"returning code, fonte, name, kcal, protein_g as p, carb_g as c, fat_g as g")
    if food["portions"]:
        vals = ", ".join(f"({lit(l)}, {g}::numeric)" for l, g in food["portions"])
        bot(f"insert into food_portions (food_id, label, grams, source) select f.id, v.label, v.grams, 'bot' "
            f"from (values {vals}) as v(label, grams) join foods f on f.code = {lit(code)} on conflict (food_id, label) do nothing")
    table(out)
    return True


def cmd_tbca(a):
    import time
    pos, o = opts(a, flags=("limit",), bools=("all",))
    if not pos:
        sys.exit('uso: fit tbca "<termo ou código>" [--all] [--limit 10]')
    term, limit = " ".join(pos), max(1, int(o.get("limit", 10)))
    rows = tbca_parse_list(tbca_get("composicao_alimentos.php", {"guarda": "tomo1", "produto": term, "cmb_grupo": "", "cmb_tipo_alimento": ""}))
    rows = [r for r in rows if r["code"].lower() == term.lower()] or rows
    if not rows:
        sys.exit(f"nada encontrado na TBCA para '{term}'")
    if len(rows) > 1 and not o.get("all"):
        table(rows[:limit], ["code", "name", "brand"])
        print(f"{len(rows)} resultados na página, nada cadastrado. Escolha: fit tbca <código> (ou --all para cadastrar os {min(limit, len(rows))} primeiros)")
        return
    for i, item in enumerate(rows[:limit]):
        if i:
            time.sleep(1.5)   # uma página por vez, sem pressa: o site bloqueia volume alto
        tbca_save(item)


def cmd_portion(a):
    if len(a) != 3:
        sys.exit('uso: fit portion <codigo> "<medida>" <gramas>')
    out = bot(f"insert into food_portions (food_id, label, grams, source) select id, {lit(a[1])}, {pnum(a[2])}, 'bot' from foods "
              f"where code = {lit(a[0])} on conflict (food_id, label) do update set grams = excluded.grams, source = 'bot' returning label, grams")
    if not out:
        sys.exit(f"erro: alimento {a[0]} não existe")
    show(out)


