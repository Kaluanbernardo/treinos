def cmd_steps(a):
    pos, o = opts(a, flags=("date",))
    if len(pos) != 1:
        sys.exit("uso: fit steps <n> [--date d]")
    raw = re.sub(r"[.\s_]", "", pos[0])  # pt-BR: "8.432" = 8432 passos
    if not raw.isdigit():
        sys.exit(f"erro: passos inválido '{pos[0]}' (inteiro, ex.: 8432 ou 8.432)")
    n = int(raw)
    if not 0 <= n < 200000:
        sys.exit("erro: passos fora da faixa (0–199999)")
    d = pdate(o.get("date"))
    show(bot(f"insert into daily_checks (date, steps, source) values ({lit(d)}, {n}, 'bot') "
             f"on conflict (date) do update set steps = excluded.steps, source = 'bot' returning date, steps"))


# ---------------------------------------------------------------- calorias
def cmd_kcal(a):
    pos, o = opts(a, flags=("session", "date", "note"))
    if len(pos) != 1 or ("session" in o and "date" in o):
        sys.exit("uso: fit kcal <kcal> [--session <id>|--date d] [--note t]")
    kcal = int(round(pnum(pos[0], "kcal")))
    if not 0 < kcal < 5000:
        sys.exit("erro: kcal fora da faixa (1–4999)")
    if "session" in o:
        s = bot(f"select id, date, title, status from v_sessions where id::text like {lit(o['session'] + '%')}")
        if len(s) != 1:
            sys.exit(f"erro: {len(s)} sessões com esse id (use um id mais longo)" if s else "erro: sessão não encontrada")
        s = s[0]
        out = bot(f"insert into exercise_kcal (date, session_id, kcal, note, source) values ({lit(s['date'])}, {lit(s['id'])}, {kcal}, "
                  f"{lit(o.get('note'))}, 'relogio') on conflict (session_id) where session_id is not null do update set "
                  f"kcal = excluded.kcal, date = excluded.date, note = coalesce(excluded.note, exercise_kcal.note) "
                  f"returning left(id::text, 8) as id, date, kcal, source")
        print(f"{s['title']} ({s['date']}, {s['status']}): {kcal} kcal do relógio")
    else:
        d = pdate(o.get("date"))
        out = bot(f"insert into exercise_kcal (date, kcal, note, source) values ({lit(d)}, {kcal}, {lit(o.get('note'))}, 'relogio') "
                  f"returning left(id::text, 8) as id, date, kcal, source")
        print(f"{d}: {kcal} kcal do relógio (dia inteiro: substitui as estimativas das sessões desse dia)")
    table(out)
    if os.environ.get("FIT_ROLLBACK"):
        print("(FIT_ROLLBACK: nada gravado)")
    else:
        cmd_kcal_day([out[0]["date"]])


def cmd_kcal_del(a):
    if len(a) != 1:
        sys.exit("uso: fit kcal-del <id (8+ caracteres)>")
    out = bot(f"delete from exercise_kcal where id::text like {lit(a[0] + '%')} returning date, kcal, session_id")
    if len(out) != 1:
        sys.exit(f"erro: {len(out)} leituras apagadas (use um id mais longo)" if out else "erro: id não encontrado")
    show(out)


def cmd_kcal_day(a):
    d = pdate(a[0] if a else None)
    r = bot(f"select * from v_energy_daily where date = {lit(d)}")
    if not r:
        sys.exit(f"{d}: sem dados (nenhum peso, refeição, treino ou kcal até essa data)")
    r = r[0]
    n = lambda v: "–" if v is None else f"{round(float(v)):,}".replace(",", ".")
    w = bot(f"select left(e.id::text, 8) as id, e.kcal, e.source, coalesce(s.title, 'dia inteiro') as sessao "
            f"from exercise_kcal e left join v_sessions s on s.id = e.session_id where e.date = {lit(d)} order by e.created_at")
    print(f"# {d}")
    if r["bmr_kcal"] is None:
        print(f"basal        –   (falta: {', '.join(r['bmr_missing'])}; Configurações no app ou fit perfil)")
    else:
        print(f"basal        {n(r['bmr_kcal'])} kcal  (Mifflin-St Jeor · {r['weight_kg']} kg · {r['height_cm']} cm · {r['age_years']} anos · {r['sex']})")
        print(f"rotina       {n(r['daily_life_kcal'])} kcal  (basal × {float(r['activity_factor']) - 1:.2f})")
    ex = f"exercício    {n(r['exercise_kcal'])} kcal"
    parts = []
    if r["exercise_watch_kcal"]:
        parts.append(f"relógio {n(r['exercise_watch_kcal'])}")
    if r["is_estimate"]:
        parts.append(f"estimativa {n(r['exercise_est_kcal'])} ({r['n_sessions_estimated']} sessão(ões) sem relógio)")
    print(ex + (f"  ({' + '.join(parts)})" if parts else ""))
    for x in w:
        print(f"  · {x['sessao']}: {x['kcal']} kcal ({x['source']}, id {x['id']})")
    print(f"gasto        {n(r['out_kcal'])} kcal" if r["out_kcal"] is not None else "gasto        –   (sem basal)")
    print(f"comida       {n(r['food_kcal'])} kcal" + ("" if r["food_logged"] else "  (nada registrado)") + ("  (tem estimativa)" if r["food_has_estimated"] else ""))
    if r["balance_kcal"] is not None:
        b = int(r["balance_kcal"])
        print(f"saldo real   {signed(b)} kcal  ({'déficit' if b < 0 else 'superávit' if b > 0 else 'empate'}; zero = manutenção)")
    else:
        print("saldo real   –   (" + ("sem basal" if r["bmr_kcal"] is None else "sem refeições no dia") + ")")
    t = bot(f"select target_balance_kcal, allowance_kcal, remaining_kcal, day_state from v_day_targets where date = {lit(d)}")
    if t:
        t = {k: (None if v == "" else v) for k, v in t[0].items()}
        tg = nz(t["target_balance_kcal"])
        if tg is not None:
            print(f"meta         saldo {signed(tg)} kcal/dia, fixa (treine ou não)")
        if t["allowance_kcal"] is not None:
            rem = nz(t["remaining_kcal"])
            gasto = f"gasto {kn(r['out_kcal'])} {chr(8722) if (tg or 0) < 0 else chr(43)} {kn(abs(tg or 0))}" if r["out_kcal"] is not None else "meta fixa, sem basal"
            print(f"pode consumir {kn(t['allowance_kcal'])} kcal  ({gasto}) · {'resta' if rem >= 0 else 'passou'} {kn(abs(rem))}")
        if t["day_state"] != "na_conta":
            why = {"hoje": "dia em andamento", "incompleto": "diário incompleto", "sem_refeicao": "sem refeição", "sem_basal": "sem basal"}[t["day_state"]]
            print(f"fora da conta do acumulado: {why}")


def cmd_perfil(a):
    _, o = opts(a, flags=("altura", "nascimento", "sexo", "fator"))
    sets = []
    if "altura" in o:
        sets.append(f"height_cm = {pnum(o['altura'], 'altura')}")
    if "nascimento" in o:
        sets.append(f"birth_date = {lit(pdate(o['nascimento']))}")
    if "sexo" in o:
        sx = o["sexo"].upper()[:1]
        if sx not in ("M", "F"):
            sys.exit("erro: --sexo M ou F")
        sets.append(f"sex = {lit(sx)}")
    if "fator" in o:
        sets.append(f"activity_factor = {pnum(o['fator'], 'fator')}")
    if sets:
        bot(f"update profile set {', '.join(sets)}, source = 'bot'")
        note("decisao", "Perfil do basal atualizado: " + ", ".join(f"{k} {v}" for k, v in o.items()) + ".", "profile")
    table(bot("select height_cm as altura_cm, birth_date as nascimento, sex as sexo, activity_factor as fator from profile"))


def cmd_saldo_alvo(a):
    """Saldo-alvo do dia (meta fixa; −300 = déficit de 300). Guardado como goals.deficit_kcal = −saldo-alvo."""
    cur = int(bot("select deficit_kcal from goals")[0]["deficit_kcal"])
    if a:
        raw = a[0].replace("−", "-").replace("+", "")
        if not re.fullmatch(r"-?\d+", raw):
            sys.exit("uso: fit saldo-alvo [kcal]   (ex.: fit saldo-alvo -300; negativo = déficit)")
        v = int(raw)
        if not -1000 <= v <= 500:
            sys.exit("erro: saldo-alvo fora de −1000 … +500 kcal/dia")
        bot(f"update goals set deficit_kcal = {-v}, source = 'bot'")
        note("decisao", f"Meta do dia (saldo-alvo): {signed(-cur)} → {signed(v)} kcal/dia, fixa. "
             f"Pode consumir = basal + rotina + exercício {signed(v)}.", "goals")
        cur = -v
    print(f"saldo-alvo   {signed(-cur)} kcal/dia (fixo, treine ou não; goals.deficit_kcal = {cur})")
    t = bot("select allowance_kcal, remaining_kcal from v_day_targets where date = today_sp()")
    if t and t[0]["allowance_kcal"] is not None:
        print(f"hoje         pode consumir {kn(t[0]['allowance_kcal'])} kcal · resta {kn(t[0]['remaining_kcal'])}")


def cmd_diario(a):
    """Marca o diário alimentar de um dia como incompleto (fora do saldo acumulado e das médias) ou completo."""
    pos, o = opts(a, flags=("nota",))
    if not pos or pos[0] not in ("incompleto", "completo"):
        sys.exit('uso: fit diario incompleto|completo [data] [--nota t]')
    d = pdate(pos[1] if len(pos) > 1 else None)
    flag = pos[0] == "incompleto"
    bot(f"insert into daily_checks (date, diary_incomplete, source) values ({lit(d)}, {'true' if flag else 'false'}, 'bot') "
        f"on conflict (date) do update set diary_incomplete = excluded.diary_incomplete, source = 'bot'")
    dm = f"{d[8:10]}/{d[5:7]}"
    note("nota", f"Diário de {dm} marcado como {'incompleto' if flag else 'completo'}: "
         + ("fica fora do saldo acumulado e das médias de macros." if flag else "volta para o saldo acumulado e as médias.")
         + (f" {o['nota']}" if o.get("nota") else ""), "daily_checks")
    table(bot(f"select date, day_state as estado, food_kcal as comida, balance_kcal as saldo_real from v_day_targets where date = {lit(d)}"))


def cmd_videos(a):
    """Confere cada exercises.video_url pelo oEmbed do YouTube (HTTP 200 = ok)."""
    bad = 0
    for r in bot("select slug, name, video_url from exercises order by name"):
        if not r["video_url"]:
            print(f"SEM   {r['slug']}")
            bad += 1
            continue
        q = "https://www.youtube.com/oembed?format=json&url=" + urllib.parse.quote(r["video_url"], safe="")
        try:
            code = urllib.request.urlopen(urllib.request.Request(q, headers={"User-Agent": "Mozilla/5.0"}), timeout=20).status
        except urllib.error.HTTPError as e:
            code = e.code
        print(f"{'ok ' if code == 200 else 'FALHA'} {code} {r['slug']} {r['video_url']}")
        bad += code != 200
    if bad:
        sys.exit(f"{bad} link(s) com problema: avisar o Kaluan no chat")


def cmd_note(a):
    if len(a) != 2 or a[0] not in NOTE_KINDS:
        sys.exit(f'uso: fit note <{"|".join(NOTE_KINDS)}> "<texto>"')
    note(a[0], a[1])
    print("ok")


COMMANDS = {
    "today": cmd_today, "week": cmd_week, "evo": cmd_evo, "summary": cmd_summary, "day": cmd_day, "food": cmd_food,
    "notes": cmd_notes, "sessions": cmd_sessions, "session": cmd_session, "log-set": cmd_log_set, "carga": cmd_carga, "target": cmd_target,
    "move": cmd_move, "skip": cmd_skip, "add": cmd_add, "body": cmd_body, "photo": cmd_photo, "meal": cmd_meal,
    "meal-del": cmd_meal_del, "meal-photo": cmd_meal_photo, "food-add": cmd_food_add, "portion": cmd_portion, "tbca": cmd_tbca, "creatine": cmd_creatine,
    "water": cmd_water, "steps": cmd_steps, "note": cmd_note, "videos": cmd_videos,
    "kcal": cmd_kcal, "kcal-del": cmd_kcal_del, "kcal-day": cmd_kcal_day, "perfil": cmd_perfil,
    "saldo-alvo": cmd_saldo_alvo, "diario": cmd_diario,
}


def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    c, rest = a[0], a[1:]
    if c == "sql" and len(rest) == 1:
        show(bot(rest[0]))
    elif c == "admin-sql" and len(rest) == 1:
        show(run(rest[0]))
    elif c in COMMANDS:
        COMMANDS[c](rest)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
